#include <windows.h>

101 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WinterStatic\0"
            VALUE "FileDescription", "WinterStatic Video Cutter\0"
            VALUE "FileVersion", "0.3.0\0"
            VALUE "InternalName", "WinterStatic-Video-Cutter\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 WinterStatic\0"
            VALUE "OriginalFilename", "WinterStatic-Video-Cutter.exe\0"
            VALUE "ProductName", "WinterStatic Video Cutter\0"
            VALUE "ProductVersion", "0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END


201 DIALOGEX 0, 0, 252, 418
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Player Options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Click to Play/Pause delay (ms):", -1, 10, 12, 138, 10
    EDITTEXT        3001, 178, 9, 54, 14, ES_NUMBER | ES_AUTOHSCROLL

    LTEXT           "OSD size:", -1, 10, 36, 80, 10
    EDITTEXT        3005, 178, 33, 54, 14, ES_NUMBER | ES_AUTOHSCROLL

    LTEXT           "OSD position:", -1, 10, 60, 80, 10
    COMBOBOX        3002, 98, 57, 134, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Playlist OSD at start of new video:", -1, 10, 84, 145, 10
    COMBOBOX        3007, 160, 81, 72, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    LTEXT           "GPU API:", -1, 10, 108, 80, 10
    COMBOBOX        3008, 98, 105, 134, 90, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "GPU API changes take effect after restarting the application.", -1,
                    10, 128, 222, 10

    LTEXT           "Subtitle size:", -1, 10, 151, 90, 10
    EDITTEXT        3006, 178, 148, 54, 14, ES_NUMBER | ES_AUTOHSCROLL

    LTEXT           "Preferred audio language:", -1, 10, 175, 122, 10
    EDITTEXT        3003, 142, 172, 90, 14, ES_AUTOHSCROLL

    LTEXT           "Preferred subtitle language:", -1, 10, 198, 126, 10
    EDITTEXT        3004, 142, 195, 90, 14, ES_AUTOHSCROLL

    LTEXT           "Use codes such as eng, jpn, deu. Leave blank for automatic.", -1,
                    10, 219, 222, 10

    AUTOCHECKBOX    "Exit fullscreen when playback ends", 3010, 10, 235, 190, 10, WS_TABSTOP

    LTEXT           "When another file is opened:", -1, 10, 253, 150, 10
    COMBOBOX        3011, 10, 265, 222, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "Hide cursor over playing video after inactivity", 3012, 10, 286, 220, 10, WS_TABSTOP

    LTEXT           "Taskbar thumbnail:", -1, 10, 309, 90, 10
    COMBOBOX        3013, 104, 306, 128, 55, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP

    AUTOCHECKBOX    "Show Stop button on toolbars", 3016, 10, 326, 190, 10, WS_TABSTOP
    AUTOCHECKBOX    "Show PREV/NEXT item buttons on toolbar", 3017, 10, 343, 220, 10, WS_TABSTOP

    LTEXT           "Screenshot save folder:", -1, 10, 362, 120, 10
    EDITTEXT        3014, 10, 374, 174, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", 3015, 188, 374, 44, 14

    PUSHBUTTON      "Keyboard shortcuts...", 3009, 10, 399, 104, 14
    DEFPUSHBUTTON   "OK", IDOK, 124, 399, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 399, 50, 14
END

202 DIALOGEX 0, 0, 258, 145
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WinterStatic Video Cutter"
FONT 9, "Segoe UI"
BEGIN
    CTEXT           "WinterStatic Video Cutter", -1, 12, 12, 234, 12
    CTEXT           "Native video cutter powered by libmpv and FFmpeg", -1, 12, 31, 234, 11
    CTEXT           "Created by WinterStatic", -1, 12, 50, 234, 11
    CTEXT           "Licensed under GPL-3.0-or-later", -1, 12, 67, 234, 11
    CTEXT           "Version 0.3.0", -1, 12, 84, 234, 11
    PUSHBUTTON      "GitHub", 4300, 76, 109, 50, 14
    DEFPUSHBUTTON   "OK", IDOK, 132, 109, 50, 14
END

